<included>
  <appender name="PER_ENDPOINT" class="ch.qos.logback.classic.sift.SiftingAppender">
    <discriminator>
      <key>endpoint</key>
      <defaultValue>_unmatched</defaultValue>
    </discriminator>
    <sift>
      <appender name="FILE-${endpoint}" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_ROOT}/${SERVICE}/${endpoint}/${SERVICE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
          <fileNamePattern>${LOG_ROOT}/${SERVICE}/${endpoint}/${SERVICE}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
          <maxFileSize>20MB</maxFileSize>
          <maxHistory>14</maxHistory>
          <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
          <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{requestId:--}] [%X{user:--}] %logger{36} - %msg%n</pattern>
        </encoder>
      </appender>
    </sift>
  </appender>
</included>
