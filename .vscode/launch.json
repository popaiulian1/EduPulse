{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "ApiGatewayApplication",
            "request": "launch",
            "mainClass": "com.edupulse.gateway.ApiGatewayApplication",
            "projectName": "api-gateway",
            "env": {
                "EDUPULSE_LOG_ROOT": "${workspaceFolder}/logs",
                "SPRINGDOC_API_DOCS_ENABLED": "true",
                "SPRINGDOC_SWAGGER_UI_ENABLED": "true"
            }
        },
        {
            "type": "java",
            "name": "AuthServiceApplication",
            "request": "launch",
            "mainClass": "com.edupulse.auth.AuthServiceApplication",
            "projectName": "auth-service",
            "env": {
                "EDUPULSE_LOG_ROOT": "${workspaceFolder}/logs",
                "SPRINGDOC_API_DOCS_ENABLED": "true",
                "SPRINGDOC_SWAGGER_UI_ENABLED": "true"
            },
            "cwd": "${workspaceFolder}/services/auth-service"
        },
        {
            "type": "java",
            "name": "DiscoveryServerApplication",
            "request": "launch",
            "mainClass": "com.edupulse.discovery.DiscoveryServerApplication",
            "projectName": "discovery-server",
            "env": { "EDUPULSE_LOG_ROOT": "${workspaceFolder}/logs" }
        },
        {
            "type": "java",
            "name": "IngestionServiceApplication",
            "request": "launch",
            "mainClass": "com.edupulse.ingestion.IngestionServiceApplication",
            "projectName": "ingestion-service",
            "env": {
                "EDUPULSE_LOG_ROOT": "${workspaceFolder}/logs",
                "EDUPULSE_STORAGE_ROOT": "${workspaceFolder}/uploads",
                "SPRINGDOC_API_DOCS_ENABLED": "true",
                "SPRINGDOC_SWAGGER_UI_ENABLED": "true"
            }
        }
    ],
    "compounds": [
        {
            "name": "All Services",
            "configurations": [
                "DiscoveryServerApplication",
                "AuthServiceApplication",
                "IngestionServiceApplication",
                "ApiGatewayApplication"
            ],
            "stopAll": true
        }
    ],
}