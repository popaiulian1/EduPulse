POSTGRES_DB=edupulse
POSTGRES_USER=edupulse
POSTGRES_PASSWORD=edupulse

OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# Embedding dimension is fixed in the pgvector schema: nomic-embed-text = 768
# Reranker: HF repo plus quantization tag
RERANKER_HF_MODEL=gpustack/bge-reranker-v2-m3-GGUF:Q8_0
